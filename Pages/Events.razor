@page "/events"
@inject Services.EventService EventService
@inject Services.SessionService SessionService
@using EventEase.Models
@inject ILogger<Events> Logger

<h2>Upcoming Events</h2>

@if (pagedEvents is null)
{
    <p>Loading events...</p>
}
else
{
    <div class="card p-3 mb-4">
        <div class="row g-3">

            <!-- Search -->
            <div class="col-md-4">
                <input class="form-control"
                    placeholder="Search by name..."
                    value="@searchTerm"
                    @oninput="@(e => { searchTerm = e.Value?.ToString() ?? ""; ApplyFilters(true); })"
                />
            </div>

            <!-- Location Filter -->
            <div class="col-md-4">
                <select class="form-select"
                        value="@selectedLocation"
                        @onchange="@(e => { selectedLocation = e.Value?.ToString() ?? ""; ApplyFilters(true); })">
                    <option value="">All Locations</option>
                    @foreach (var loc in locations)
                    {
                        <option value="@loc">@loc</option>
                    }
                </select>
            </div>

            <!-- Month/Year Filter -->
            <div class="col-md-4">
                <input type="month"
                    class="form-control"
                    value="@selectedMonthYear"
                    @oninput="@(e => { selectedMonthYear = e.Value?.ToString(); ApplyFilters(true); })" />
            </div>
            
        </div>
    </div>

    @foreach (var ev in pagedEvents)
    {
        <EventCard Event="ev" />
    }

    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination">

                <li class="page-item @(HasPreviousPage ? "" : "disabled")">
                    <button class="page-link"
                            @onclick="PreviousPage"
                            disabled="@(!HasPreviousPage)">
                        Previous
                    </button>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    var pageNumber = i;

                    <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                        <button class="page-link"
                                @onclick="() => GoToPage(pageNumber)">
                            @pageNumber
                        </button>
                    </li>
                }

                <li class="page-item @(HasNextPage ? "" : "disabled")">
                    <button class="page-link"
                            @onclick="NextPage"
                            disabled="@(!HasNextPage)">
                        Next
                    </button>
                </li>

            </ul>
        </nav>
    </div>

}

@code {
    private List<Event> allEvents = new();
    private List<Event> filteredEvents = new();
    private List<Event> pagedEvents = new();

    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages;

    private string searchTerm = "";
    private string selectedLocation = "";
    private string? selectedMonthYear;


    private List<string> locations = new();

    protected override void OnInitialized()
    {
        Logger?.LogInformation("Fetching data...");
        allEvents = EventService.GetEvents();
        Logger?.LogInformation("Data fetch completed.");

        // Extract unique locations
        locations = allEvents
            .Select(e => e.Location)
            .Distinct()
            .OrderBy(l => l)
            .ToList();

        ApplyFilters();
    }

    void ApplyFilters(bool resetPage = true)
    {
        IEnumerable<Event> query = allEvents;

        // Search by name
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            query = query.Where(e =>
                e.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }

        // Filter by location
        if (!string.IsNullOrWhiteSpace(selectedLocation))
        {
            query = query.Where(e => e.Location == selectedLocation);
        }

        // Filter by month/year
        if (!string.IsNullOrWhiteSpace(selectedMonthYear) && selectedMonthYear.Contains('-'))
        {
            var parts = selectedMonthYear.Split('-');

            if (parts.Length == 2 &&
                int.TryParse(parts[0], out int year) &&
                int.TryParse(parts[1], out int month))
            {
                query = query.Where(e => e.Date.Year == year && e.Date.Month == month);
            }
        }

        filteredEvents = query.ToList();

        if (resetPage)
            currentPage = 1;

        totalPages = (int)Math.Ceiling(filteredEvents.Count / (double)pageSize);

        LoadPage();
    }


    void LoadPage()
    {
        pagedEvents = filteredEvents
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    void NextPage()
    {
        if (HasNextPage)
        {
            currentPage++;
            ApplyFilters(resetPage: false);
        }
    }

    void PreviousPage()
    {
        if (HasPreviousPage)
        {
            currentPage--;
            ApplyFilters(resetPage: false);
        }
    }

    void GoToPage(int page)
    {
        currentPage = page;
        ApplyFilters(resetPage: false);
    }

    bool HasNextPage => currentPage < totalPages;
    bool HasPreviousPage => currentPage > 1;

    // Trigger filtering when inputs change
    private void OnFilterChanged(ChangeEventArgs e) => ApplyFilters();
}

